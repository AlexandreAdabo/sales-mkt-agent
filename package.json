{
  "name": "sales-mkt-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Automação enxuta de prospecção outbound e ideias de conteúdo com Node.js, SQLite e Discord.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "job:leads": "node src/scripts/run-leads.js",
    "job:content": "node src/scripts/run-content.js",
    "db:init": "node src/scripts/init-db.js",
    "test:openai": "node scripts/test-openai.js",
    "test:discord": "node scripts/test-discord.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "openai": "^6.0.0"
  }
}
